{
  "name": "port-allowlist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy --secrets-file .local/worker-secrets.json",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:agent": "python3 -m unittest discover -s agent/tests -v",
    "setup": "node scripts/setup.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "22.20.5",
    "cf": "1.0.0-beta.26",
    "esbuild": "0.28.2",
    "miniflare": "5.20261101.0-beta",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "Self-service, single-port IP allowlists with Cloudflare and an ECS-local Alibaba Cloud synchronizer",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  }
}
