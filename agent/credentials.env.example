# Replace all placeholders on ECS only. chmod 600 this file before use.
# Agent token comes from the ignored .local/credentials.json on your operator machine.
PROXY_ACCESS_AGENT_KEY=REPLACE_AGENT_TOKEN
ALIYUN_ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
ALIYUN_ACCESS_KEY_SECRET=REPLACE_ACCESS_KEY_SECRET
